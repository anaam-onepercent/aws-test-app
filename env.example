# Copy this file to .env and fill in your database details.
# Never upload the real .env file to GitHub.

PORT=3000

# From Lightsail > Databases > your database > Connect tab
DB_HOST=your-database-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=dbmasteruser
DB_PASSWORD=your-password-here
DB_NAME=testdb
DB_SSL=true
